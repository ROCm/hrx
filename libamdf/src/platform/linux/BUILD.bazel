load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

amdf_cc_library(
    name = "file",
    hdrs = ["file.h"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src:__subpackages__"],
)

amdf_cc_library(
    name = "instance",
    srcs = ["instance.c"],
    hdrs = ["instance.h"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":file",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "endpoint",
    srcs = ["endpoint.c"],
    hdrs = ["endpoint.h"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":file",
        ":instance",
        "//libamdf/src:pci",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "linux",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src:__pkg__"],
    deps = [
        ":endpoint",
        ":instance",
    ],
)

amdf_cc_test(
    name = "endpoint_test",
    srcs = ["endpoint_test.cc"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":endpoint",
        ":file",
        "//libamdf/src/platform",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
