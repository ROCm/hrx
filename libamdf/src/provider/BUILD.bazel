load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "provider",
    srcs = [
        "amdf.c",
        "extension.c",
    ],
    hdrs = ["extension.h"],
    defines = select({
        "//libamdf/config/family:xdna": ["AMDF_HAVE_XDNA=1"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf:__pkg__"],
    deps = ["//libamdf/src:core"] + select({
        "//libamdf/config/family:xdna": ["//libamdf/src/xdna"],
        "//conditions:default": [],
    }),
)
