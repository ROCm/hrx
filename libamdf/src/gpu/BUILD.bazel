load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "endpoint_profile",
    srcs = ["endpoint_profile.c"],
    hdrs = ["endpoint_profile.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
)

amdf_cc_library(
    name = "device",
    srcs = [
        "device.c",
        "memory.c",
    ],
    hdrs = [
        "device.h",
        "memory.h",
    ],
    deps = [
        "//libamdf/src:device",
        "//libamdf/src:endpoint",
        "//libamdf/src:host_mapping",
        "//libamdf/src:memory",
        "//libamdf/src:structure",
        "//libamdf/src/gpu/umd:device",
        "//libamdf/src/gpu/umd:memory",
    ],
)

amdf_cc_library(
    name = "kernel_queue",
    srcs = ["kernel_queue.c"],
    hdrs = ["kernel_queue.h"],
    deps = [
        ":device",
        "//libamdf/src:atomics",
        "//libamdf/src:device",
        "//libamdf/src:endpoint",
        "//libamdf/src:kernel_queue",
        "//libamdf/src:memory",
        "//libamdf/src:structure",
        "//libamdf/src/gpu/umd:kernel_queue",
    ],
)

amdf_cc_library(
    name = "extension",
    srcs = ["extension.c"],
    hdrs = ["extension.h"],
    visibility = ["//libamdf/src/provider:__pkg__"],
    deps = [
        ":device",
        ":endpoint_profile",
        ":kernel_queue",
        "//libamdf/src:endpoint",
        "//libamdf/src:structure",
        "//libamdf/src/gpu/umd",
    ],
)

amdf_cc_library(
    name = "gpu",
    visibility = ["//libamdf/src/provider:__pkg__"],
    deps = [":extension"],
)

amdf_cc_test(
    name = "endpoint_profile_test",
    srcs = ["endpoint_profile_test.cc"],
    deps = [
        ":endpoint_profile",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
