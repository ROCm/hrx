load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "device_state",
    hdrs = ["device.h"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "//libamdf/src/gpu/umd:device",
        "//libamdf/src/gpu/umd/wddm/wkmi:adapter",
        "//libamdf/src/platform/windows:kmt_api",
    ],
)

amdf_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    hdrs = ["memory.h"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":device_state",
        "//libamdf/src/gpu/umd:memory",
        "//libamdf/src/platform/windows:host_cache",
    ],
)

amdf_cc_library(
    name = "device",
    srcs = ["device.c"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":device_state",
        ":memory",
        "//libamdf/src/platform/windows:endpoint",
    ],
)

amdf_cc_library(
    name = "endpoint_profile",
    srcs = ["endpoint_profile.c"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/gpu/umd:__pkg__"],
    deps = [
        "//libamdf/src/gpu:endpoint_profile",
        "//libamdf/src/gpu/umd:endpoint_profile",
        "//libamdf/src/gpu/umd/wddm/wkmi:adapter",
        "//libamdf/src/gpu/umd/wddm/wkmi:endpoint_properties",
        "//libamdf/src/platform/windows:endpoint",
    ],
)

amdf_cc_library(
    name = "wddm",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/gpu/umd:__pkg__"],
    deps = [
        ":device",
        ":endpoint_profile",
    ],
)
