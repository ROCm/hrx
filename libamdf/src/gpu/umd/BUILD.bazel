load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "device",
    hdrs = ["device.h"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = ["//libamdf/src/platform"],
)

amdf_cc_library(
    name = "endpoint_profile",
    hdrs = ["endpoint_profile.h"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [
        "//libamdf/src/gpu:endpoint_profile",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "memory",
    hdrs = ["memory.h"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
)

amdf_cc_library(
    name = "kernel_queue",
    hdrs = ["kernel_queue.h"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [":device"],
)

amdf_cc_library(
    name = "umd",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/gpu:__pkg__"],
    deps = [
        ":device",
        ":endpoint_profile",
        ":kernel_queue",
        ":memory",
        "//libamdf/src/gpu/umd/wddm",
    ],
)
