load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

DRM_COMPATIBILITY = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

amdf_cc_library(
    name = "buffer",
    srcs = ["buffer.c"],
    hdrs = ["buffer.h"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = ["//libamdf/src/platform/linux:file"],
)

amdf_cc_library(
    name = "device_state",
    hdrs = ["device.h"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":buffer",
        "//libamdf/src:atomics",
        "//libamdf/src/platform/linux:release_list",
        "//libamdf/src/xdna/umd:command",
        "//libamdf/src/xdna/umd:device",
    ],
)

amdf_cc_library(
    name = "device",
    srcs = ["device.c"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":buffer",
        ":command",
        ":device_state",
        "//libamdf/src/platform/linux:endpoint",
        "//libamdf/src/platform/linux:file",
        "//libamdf/src/platform/linux:host_cache",
        "//libamdf/src/platform/linux:release_list",
        "//libamdf/src/xdna/target/npu5:bootstrap",
        "//libamdf/src/xdna/target/npu5:context",
        "//libamdf/src/xdna/umd:device",
    ],
)

amdf_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    hdrs = ["memory.h"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":buffer",
        ":device_state",
        "//libamdf/src/platform/linux:host_cache",
        "//libamdf/src/platform/linux:release_list",
        "//libamdf/src/xdna/umd:memory",
    ],
)

amdf_cc_library(
    name = "command",
    srcs = ["command.c"],
    hdrs = ["command.h"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":buffer",
        ":device_state",
        ":memory",
        "//libamdf/src/platform/linux:host_cache",
        "//libamdf/src/platform/linux:release_list",
        "//libamdf/src/xdna:transaction",
        "//libamdf/src/xdna/target/npu5:ert_packet",
        "//libamdf/src/xdna/umd:command",
    ],
)

amdf_cc_library(
    name = "kernel_queue",
    srcs = ["kernel_queue.c"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":command",
        ":device_state",
        "//libamdf/src:atomics",
        "//libamdf/src:wait",
        "//libamdf/src/platform:wait",
        "//libamdf/src/platform/linux:file",
        "//libamdf/src/platform/linux:host_cache",
        "//libamdf/src/xdna/target/npu5:bootstrap",
        "//libamdf/src/xdna/target/npu5:ert_packet",
        "//libamdf/src/xdna/umd:command",
        "//libamdf/src/xdna/umd:kernel_queue",
    ],
)

amdf_cc_library(
    name = "drm",
    target_compatible_with = DRM_COMPATIBILITY,
    visibility = ["//libamdf/src/xdna:__pkg__"],
    deps = [
        ":command",
        ":device",
        ":kernel_queue",
        ":memory",
    ],
)

amdf_cc_test(
    name = "device_test",
    srcs = ["device_test.cc"],
    tags = ["manual"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":device",
        ":device_state",
        ":memory",
        "//libamdf/src/platform",
        "//libamdf/src/platform/linux:endpoint",
        "//libamdf/src/xdna:endpoint_profile",
        "//libamdf/src/xdna/target/npu5:bootstrap",
        "//libamdf/src/xdna/target/npu5:context",
        "//libamdf/src/xdna/umd:device",
        "//libamdf/src/xdna/umd:memory",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
