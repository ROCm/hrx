load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

amdf_cc_library(
    name = "bootstrap",
    srcs = ["bootstrap.c"],
    hdrs = ["bootstrap.h"],
    visibility = ["//libamdf/src/xdna:__subpackages__"],
)

amdf_cc_library(
    name = "context",
    hdrs = ["context.h"],
    visibility = ["//libamdf/src/xdna:__subpackages__"],
)

amdf_cc_library(
    name = "ert_packet",
    srcs = ["ert_packet.c"],
    hdrs = ["ert_packet.h"],
    visibility = ["//libamdf/src/xdna:__subpackages__"],
)

amdf_cc_test(
    name = "ert_packet_test",
    srcs = ["ert_packet_test.cc"],
    deps = [
        ":ert_packet",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
