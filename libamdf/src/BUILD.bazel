load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "atomics",
    hdrs = ["atomics.h"],
    visibility = ["//libamdf/src:__subpackages__"],
)

amdf_cc_library(
    name = "child_tracker",
    srcs = ["child_tracker.c"],
    hdrs = ["child_tracker.h"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [":atomics"],
)

amdf_cc_library(
    name = "structure",
    srcs = ["structure.c"],
    hdrs = ["structure.h"],
    visibility = ["//libamdf/src:__subpackages__"],
)

amdf_cc_library(
    name = "pci",
    srcs = ["pci.c"],
    hdrs = ["pci.h"],
    visibility = ["//libamdf/src:__subpackages__"],
)

amdf_cc_library(
    name = "instance",
    srcs = ["instance.c"],
    hdrs = ["instance.h"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":child_tracker",
        ":structure",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "endpoint",
    srcs = ["endpoint.c"],
    hdrs = ["endpoint.h"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":child_tracker",
        ":instance",
        ":structure",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "device",
    srcs = ["device.c"],
    hdrs = ["device.h"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":child_tracker",
        ":endpoint",
    ],
)

amdf_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    hdrs = ["memory.h"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":child_tracker",
        ":device",
        ":structure",
    ],
)

amdf_cc_library(
    name = "host_mapping",
    srcs = ["host_mapping.c"],
    hdrs = ["host_mapping.h"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":memory",
        ":structure",
    ],
)

amdf_cc_library(
    name = "kernel_queue",
    srcs = ["kernel_queue.c"],
    hdrs = ["kernel_queue.h"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":device",
        ":structure",
    ],
)

amdf_cc_library(
    name = "core",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/provider:__pkg__"],
    deps = [
        ":device",
        ":endpoint",
        ":host_mapping",
        ":instance",
        ":kernel_queue",
        ":memory",
        ":pci",
        ":structure",
    ] + select({
        "@platforms//os:windows": ["//libamdf/src/platform/windows"],
        "//conditions:default": [],
    }),
)

amdf_cc_test(
    name = "atomics_test",
    srcs = ["atomics_test.cc"],
    deps = [
        ":atomics",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "pci_test",
    srcs = ["pci_test.cc"],
    deps = [
        ":pci",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
