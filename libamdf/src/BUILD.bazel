load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "atomics",
    hdrs = ["atomics.h"],
)

amdf_cc_library(
    name = "child_tracker",
    srcs = ["child_tracker.c"],
    hdrs = ["child_tracker.h"],
    deps = [":atomics"],
)

amdf_cc_library(
    name = "structure",
    srcs = ["structure.c"],
    hdrs = ["structure.h"],
)

amdf_cc_library(
    name = "core",
    srcs = [
        "amdf.c",
        "endpoint.c",
        "instance.c",
    ],
    hdrs = [
        "endpoint.h",
        "instance.h",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf:__pkg__"],
    deps = [
        ":child_tracker",
        ":structure",
        "//libamdf/src/platform",
        "//libamdf/src/platform/windows",
    ],
)

amdf_cc_test(
    name = "atomics_test",
    srcs = ["atomics_test.cc"],
    deps = [
        ":atomics",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
