load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "core_tests",
    testonly = True,
    srcs = [
        "discovery_test.cc",
        "query_test.cc",
    ],
    deps = [
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
    alwayslink = True,
)

amdf_cts_test_suite(
    name = "core",
    suites = [":core_tests"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)
