load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "query_tests",
    testonly = True,
    srcs = ["query_test.cc"],
    deps = [
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
    alwayslink = True,
)

amdf_cts_test_suite(
    name = "core",
    suites = [":query_tests"],
    visibility = ["//visibility:public"],
)
