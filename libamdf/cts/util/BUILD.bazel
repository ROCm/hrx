load("//build_tools/bazel:select.bzl", "iree_select")
load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")

package(
    default_visibility = ["//libamdf/cts:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(["test_main.cc"])

amdf_cc_library(
    name = "provider_headers",
    testonly = True,
    hdrs = ["provider.h"],
    includes = [".."],
)

amdf_cc_library(
    name = "linked_provider",
    testonly = True,
    srcs = ["linked_provider.cc"],
    deps = [":provider_headers"],
)

amdf_cc_library(
    name = "dynamic_provider_posix",
    testonly = True,
    srcs = ["dynamic_provider_posix.cc"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":provider_headers",
        "//build_tools/bazel:dl",
    ],
)

amdf_cc_library(
    name = "dynamic_provider_win32",
    testonly = True,
    srcs = ["dynamic_provider_win32.cc"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":provider_headers"],
)

amdf_cc_library(
    name = "dynamic_provider",
    testonly = True,
    deps = iree_select({
        "@platforms//os:windows": [":dynamic_provider_win32"],
        "//conditions:default": [":dynamic_provider_posix"],
    }),
)
