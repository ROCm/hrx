aie2p.target<array> @array_target

aie2p.target<core> @core_target

pipeline.def<kernel> public retain target(@array_target) @first_array() launch(%input: buffer, %output: buffer) {
  %worker_lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %worker_lanes : index -> group

  %input_view = buffer.view %input[%base] : buffer -> view<1x1xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xf32>

  %records = pipeline.scatter %input_view across %workers : view<1x1xf32>, group -> pipeline.flow<tile<1xf32>>
  %partials = pipeline.stage @copy_record on %workers(%records) : (group, pipeline.flow<tile<1xf32>>) -> (pipeline.flow<tile<1xf32>>)
  %result = pipeline.fold<addf> %partials : pipeline.flow<tile<1xf32>>
  pipeline.write %result to %output_view : pipeline.flow<tile<1xf32>>, view<1xf32>
  pipeline.return
}

pipeline.def<kernel> public retain target(@array_target) @second_array() launch(%input: buffer, %output: buffer) {
  %worker_lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %worker_lanes : index -> group

  %input_view = buffer.view %input[%base] : buffer -> view<1x1xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xf32>

  %records = pipeline.scatter %input_view across %workers : view<1x1xf32>, group -> pipeline.flow<tile<1xf32>>
  %partials = pipeline.stage @copy_record on %workers(%records) : (group, pipeline.flow<tile<1xf32>>) -> (pipeline.flow<tile<1xf32>>)
  %result = pipeline.fold<addf> %partials : pipeline.flow<tile<1xf32>>
  pipeline.write %result to %output_view : pipeline.flow<tile<1xf32>>, view<1xf32>
  pipeline.return
}

pipeline.def<kernel> public retain target(@array_target) @fanout_array() launch(%input: buffer, %output0: buffer, %output1: buffer) {
  %lane_count = index.constant 1 : index
  %base = index.constant 0 : offset
  %producers = group.create %lane_count : index -> group
  %consumers0 = group.create %lane_count : index -> group
  %consumers1 = group.create %lane_count : index -> group

  %input_view = buffer.view %input[%base] : buffer -> view<1xf32>
  %output_view0 = buffer.view %output0[%base] : buffer -> view<1xf32>
  %output_view1 = buffer.view %output1[%base] : buffer -> view<1xf32>

  %input_flow = pipeline.read %input_view on %producers : view<1xf32>, group -> pipeline.flow<tile<1xf32>>
  %shared_flow = pipeline.stage @copy_record on %producers(%input_flow) : (group, pipeline.flow<tile<1xf32>>) -> (pipeline.flow<tile<1xf32>>)
  %output_flow0 = pipeline.stage @copy_record on %consumers0(%shared_flow) : (group, pipeline.flow<tile<1xf32>>) -> (pipeline.flow<tile<1xf32>>)
  %output_flow1 = pipeline.stage @copy_record on %consumers1(%shared_flow) : (group, pipeline.flow<tile<1xf32>>) -> (pipeline.flow<tile<1xf32>>)
  pipeline.write %output_flow0 to %output_view0 : pipeline.flow<tile<1xf32>>, view<1xf32>
  pipeline.write %output_flow1 to %output_view1 : pipeline.flow<tile<1xf32>>, view<1xf32>
  pipeline.return
}

pipeline.def<kernel> public retain target(@array_target) @partitioned_write_array() launch(%input: buffer, %output: buffer) {
  %lane_count = index.constant 2 : index
  %base = index.constant 0 : offset
  %workers = group.create %lane_count : index -> group

  %input_view = buffer.view %input[%base] : buffer -> view<2x3x1xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<2x3x1xf32>

  %input_flow = pipeline.scatter %input_view across %workers : view<2x3x1xf32>, group -> pipeline.flow<tile<1xf32>>
  %output_flow = pipeline.stage @copy_record on %workers(%input_flow) : (group, pipeline.flow<tile<1xf32>>) -> (pipeline.flow<tile<1xf32>>)
  pipeline.write %output_flow to %output_view : pipeline.flow<tile<1xf32>>, view<2x3x1xf32>
  pipeline.return
}

func.def target(@core_target) @copy_record(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 4} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<1xf32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<1xf32>
  %value = view.load %input_view[0] : view<1xf32> -> f32
  view.store %value, %output_view[0] : f32, view<1xf32>
  func.return
}
