func.def target(@core_target) @extsi_i16x16_i32x16(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<16xi16>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<16xi32>
  %input_value = vector.load %input_view[0] : view<16xi16> -> vector<16xi16>
  %result = vector.extsi %input_value : vector<16xi16> to vector<16xi32>
  vector.store %result, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

