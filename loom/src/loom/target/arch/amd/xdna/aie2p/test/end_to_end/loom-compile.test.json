{
  "version": 1,
  "cases": [
    {
      "name": "compiles a resident split-K array to one XDNA product",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/split_k.loom",
          "--format=xdna",
          "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
          "--output={tmp}/split_k.xdna",
          "--compile-report=details"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"artifact_kind\":\"hal-executable\"",
            "\"backend\":\"xdna\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"plan_key\":\"bf16bf16_m8n8k1\"",
            "\"spill_count\":0"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/split_k.xdna",
          "non_empty": true
        }
      ]
    },
    {
      "name": "compiles promoted F32 carrier arithmetic into an XDNA product",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/f32_carrier.loom",
          "--backend=xdna",
          "--target=amd.xdna.strix_halo.17f0_11",
          "--output={tmp}/f32_carrier.xdna",
          "--compile-report=details"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"artifact_kind\":\"hal-executable\"",
            "\"backend\":\"xdna\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"entries\":{\"count\":2",
            "\"function\":\"add_f32x4\"",
            "\"spill_count\":0"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/f32_carrier.xdna",
          "non_empty": true
        }
      ]
    }
  ]
}
