{
  "version": 1,
  "cases": [
    {
      "name": "compiles a resident split-K array to one XDNA product",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/split_k.loom",
          "--format=xdna",
          "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
          "--output={tmp}/split_k.xdna",
          "--compile-report=details"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"artifact_kind\":\"hal-executable\"",
            "\"backend\":\"xdna\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"plan_key\":\"bf16bf16_m8n8k1\"",
            "\"spill_count\":0"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/split_k.xdna",
          "non_empty": true
        }
      ]
    },
    {
      "name": "reports fixed-record spatial realization details",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/fixed_record_report.loom",
          "--format=xdna",
          "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
          "--output={tmp}/fixed_record_report.xdna",
          "--compile-report=details"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"pipeline_plan\":{\"root\":\"fixed_record_report_array\"",
            "\"realization\":\"spatial-program\"",
            "\"entry\":\"zero_partial\"",
            "\"finite_loop_trip_count\":2",
            "\"schema\":\"ggml.q5_k\"",
            "\"schema_record_byte_count\":176",
            "\"schema_records_per_channel_record\":1",
            "\"transform\":\"none\"",
            "\"task_byte_count\":352",
            "\"task_repeat_count\":1"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/fixed_record_report.xdna",
          "non_empty": true
        }
      ]
    },
    {
      "name": "compiles promoted F32 carrier arithmetic into an XDNA product",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/f32_carrier.loom",
          "--format=xdna",
          "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
          "--output={tmp}/f32_carrier.xdna",
          "--compile-report=details"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"artifact_kind\":\"hal-executable\"",
            "\"backend\":\"xdna\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"entries\":{\"count\":2",
            "\"function\":\"f32_carrier\"",
            "\"spill_count\":0"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/f32_carrier.xdna",
          "non_empty": true
        }
      ]
    },
    {
      "name": "compiles a routed GGML Q4_K gate/up SwiGLU pipeline",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/q4_q5_k_record_contraction.loom",
          "--root=q4_k_gate_up_array",
          "--format=xdna",
          "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
          "--config=q4_q5_gate_up.input_size=32768",
          "--output={tmp}/q4_k_gate_up.xdna",
          "--compile-report=text-summary"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "COMPILE-REPORT: summary artifact=hal-executable status=OK",
            "backend=xdna",
            "COMPILE-REPORT: pipeline root=q4_k_gate_up_array realization=spatial-program",
            "function=q4_k_projection_branch",
            "function=q4_k_gate_up_array$worker$0",
            "function=gate_up_swiglu",
            " spills=0 spill_plans=0"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/q4_k_gate_up.xdna",
          "non_empty": true
        }
      ]
    },
    {
      "name": "compiles a routed GGML Q5_K gate/up SwiGLU pipeline",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/q4_q5_k_record_contraction.loom",
          "--root=q5_k_gate_up_array",
          "--format=xdna",
          "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
          "--config=q4_q5_gate_up.input_size=1024",
          "--output={tmp}/q5_k_gate_up.xdna",
          "--compile-report=text-summary"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "COMPILE-REPORT: summary artifact=hal-executable status=OK",
            "backend=xdna",
            "COMPILE-REPORT: pipeline root=q5_k_gate_up_array realization=spatial-program",
            "function=q5_k_projection_branch",
            "function=q5_k_gate_up_array$worker$0",
            "function=gate_up_swiglu",
            " spills=0 spill_plans=0"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/q5_k_gate_up.xdna",
          "non_empty": true
        }
      ]
    }
  ]
}
