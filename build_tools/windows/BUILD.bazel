# Bazel toolchain configuration has no CMake target surface.
# bazel-to-cmake: skip

package(default_visibility = ["//visibility:public"])

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

exports_files(["toolchain.bzl"])
