vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "initialize"
    string @string1 = "launch_config"
  }

  section signatures alignment(8) {
    signature @signature0 () -> ()
    signature @signature1 (i32) -> (i32)
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
    callable @callable1 flags([]) depth(0) : @signature1
  }

  section exports alignment(8) {
    export @export0 name(@string0) : @callable0 = @function0
    export @export1 name(@string1) : @callable1 = @function1
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 0, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      control.return
    }
    func @function1 : @callable1 flags([]) frame(local_bytes = 0, value_registers = 1, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      %v0 = integer.neg.i32 %v0
      %v0 = integer.neg.i32 %v0
      %v0 = integer.neg.i32 %v0
      control.return
    }
  }

}
