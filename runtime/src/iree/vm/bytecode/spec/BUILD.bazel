load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

iree_py_library(
    name = "model",
    srcs = [
        "__init__.py",
        "isa/__init__.py",
        "isa/core/__init__.py",
        "isa/core/abi.py",
        "isa/core/buffer.py",
        "isa/core/constant.py",
        "isa/core/control.py",
        "isa/core/conversion.py",
        "isa/core/float.py",
        "isa/core/function.py",
        "isa/core/globals.py",
        "isa/core/integer.py",
        "isa/core/ref.py",
        "isa/core/rules.py",
        "isa/core/stack.py",
        "isa/core/value.py",
        "isa/validation.py",
        "module/__init__.py",
        "module/container.py",
        "module/numeric.py",
        "module/records.py",
        "module/rules.py",
        "module/validation.py",
        "render/__init__.py",
        "schema.py",
        "specification.py",
        "version.py",
    ],
    imports = ["../../../.."],
)

iree_py_library(
    name = "generation",
    srcs = ["generation.py"],
)

iree_py_library(
    name = "runtime_renderer",
    srcs = ["render/c_runtime.py"],
    imports = ["../../../.."],
    deps = [":model"],
)

iree_py_library(
    name = "conversion_test_renderer",
    testonly = True,
    srcs = ["conversion_test_vectors.py"],
    imports = ["../../../.."],
    deps = [":model"],
)

iree_py_library(
    name = "documentation_renderer",
    srcs = ["render/markdown.py"],
    imports = ["../../../.."],
    deps = [":model"],
)

iree_py_library(
    name = "tooling_renderer",
    srcs = [
        "render/c_assembler.py",
        "render/c_disassembler.py",
        "render/c_tooling.py",
    ],
    imports = ["../../../.."],
    deps = [
        ":model",
        ":text_model",
    ],
)

iree_py_library(
    name = "text_model",
    srcs = [
        "text/__init__.py",
        "text/instruction.py",
        "text/module/__init__.py",
        "text/module/layout.py",
        "text/module/syntax.py",
        "text/module/validation.py",
        "text/specification.py",
    ],
    imports = ["../../../.."],
    deps = [":model"],
)

iree_py_binary(
    name = "generate_runtime",
    srcs = ["generate_runtime.py"],
    main = "generate_runtime.py",
    deps = [
        ":generation",
        ":model",
        ":runtime_renderer",
    ],
)

iree_py_binary(
    name = "generate_conversion_tests",
    testonly = True,
    srcs = ["generate_conversion_tests.py"],
    main = "generate_conversion_tests.py",
    deps = [
        ":conversion_test_renderer",
        ":generation",
        ":model",
    ],
)

iree_py_binary(
    name = "generate_documentation",
    srcs = ["generate_documentation.py"],
    main = "generate_documentation.py",
    deps = [
        ":documentation_renderer",
        ":generation",
        ":model",
    ],
)

iree_py_binary(
    name = "generate_tooling",
    srcs = ["generate_tooling.py"],
    main = "generate_tooling.py",
    deps = [
        ":generation",
        ":model",
        ":text_model",
        ":tooling_renderer",
    ],
)

iree_py_test(
    name = "spec_test",
    size = "small",
    srcs = ["spec_test.py"],
    deps = [":model"],
)

iree_py_test(
    name = "projection_test",
    size = "small",
    srcs = ["projection_test.py"],
    deps = [
        ":documentation_renderer",
        ":model",
        ":runtime_renderer",
        ":text_model",
        ":tooling_renderer",
    ],
)

iree_py_test(
    name = "text_test",
    size = "small",
    srcs = ["text_test.py"],
    deps = [":text_model"],
)

test_suite(
    name = "tests",
    tests = [
        ":projection_test",
        ":spec_test",
        ":text_test",
    ],
)

